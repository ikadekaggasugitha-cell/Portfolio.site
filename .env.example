# =============================================================
# Portfolio IT — Root Environment (example)
# =============================================================
# Run `cp .env.example .env` then fill in real values, then
# run `./setup.sh` to generate backend/.env and frontend/.env.local
# =============================================================

# --- Backend: Laravel ---
APP_NAME=PortfolioIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local dev: matches docker-compose.yml's portfolio-mysql service.
# Production: Aiven-managed MySQL (see README "Production" section).
DB_CONNECTION=mysql
DB_HOST=portfolio-mysql
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_password

SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=portfolio-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Disk for user-uploaded media (profile photo, project images).
# Local/Docker: "public". Production (Vercel Functions are read-only): "s3".
MEDIA_DISK=public

# S3-compatible object storage (Cloudflare R2) - only needed when MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=portfolio-mailpit
MAIL_PORT=1025

# Generate with: docker compose exec portfolio-api php artisan jwt:secret --show
JWT_SECRET=

# --- Frontend: Next.js ---
FRONTEND_URL=http://localhost:3000
API_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api/v1
# Per-attempt budget for the public site's server-side API calls (ms, default 20000).
# Must clear the API's slowest response or every public page silently falls back to the
# placeholder content in src/lib/marketing/content.ts. Laravel-on-Vercel against a managed
# MySQL measures ~6s warm / >10s cold, so leave plenty of headroom.
API_FETCH_TIMEOUT_MS=20000
# Emergency only. `npm run build` refuses to build when the API is unreachable, because a
# build without it silently publishes the placeholder copy from lib/marketing/content.ts
# over a site that is currently correct. Set to "true" to ship anyway.
# ALLOW_DEGRADED_BUILD=true
ZENMUX_API_KEY=

# =============================================================
# Portfolio IT — Root Environment (example)
# =============================================================
# Run `cp .env.example .env` then fill in real values, then
# run `./setup.sh` to generate backend/.env and frontend/.env.local
# =============================================================

# --- Backend: Laravel ---
APP_NAME=PortfolioIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local dev: matches docker-compose.yml's portfolio-mysql service.
# Production: Aiven-managed MySQL (see README "Production" section).
DB_CONNECTION=mysql
DB_HOST=portfolio-mysql
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_password

SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=portfolio-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=smtp
MAIL_HOST=portfolio-mailpit
MAIL_PORT=1025

# Generate with: docker compose exec portfolio-api php artisan jwt:secret --show
JWT_SECRET=

# --- Frontend: Next.js ---
FRONTEND_URL=http://localhost:3000
API_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api/v1
ZENMUX_API_KEY=

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk used for user-uploaded media (profile photo, project images).
# Local/Docker: "public". Production (Vercel Functions are read-only): "s3".
# Local/Docker: "database". Production (Vercel Serverless): "sync"
QUEUE_CONNECTION=database

# Local/Docker: "file" or "database". Production (Vercel + Aiven): "redis"
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production Aiven Redis: REDIS_URL=rediss://default:PASSWORD@HOST:PORT

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage, used when MEDIA_DISK=s3 (production runs
# this against Cloudflare R2 — R2 speaks the S3 API).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 requires region "auto"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# R2 S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public base URL blobs are served from (R2 public bucket URL or custom domain)
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
